# Klarbog — example environment (DEV)
# Copy to `.env` (gitignored) or export in the shell that starts klarbog-api / klarbog-mcp.
# All variables are optional for offline CSV/local-disk workflows. Never commit secrets.

# --- Data isolation ----------------------------------------------------------
# Company dirs must live under this root (API/MCP AuthZ allowlist).
# KLARBOG_ALLOWLIST_ROOT=/path/to/klarbog-data
# ALLOWLIST_ROOT=                     # alias used by ./scripts/verify.sh

# --- HTTP listen (klarbog-api; ADR-003 / ADR-014 / ADR-015) -------------------
# Default: 127.0.0.1:3195 (loopback). Never enable non-loopback by default.
# KLARBOG_BIND=127.0.0.1:3195
# Non-loopback requires BOTH the allow flag AND an explicit KLARBOG_BIND:
# KLARBOG_ALLOW_NON_LOOPBACK=0
# KLARBOG_ALLOW_NON_LOOPBACK=1
# KLARBOG_BIND=0.0.0.0:3195
# Prefer TLS at a reverse proxy in front of loopback Klarbog (ADR-015).
# Residual: no in-process TLS; actor-header auth only; operator-owned backups.
# Checklist: docs/skills/production-checklist.md
# Scaffold only — not a public deploy.

# --- Optional HTTP API token (ADR-016) --------------------------------------
# When set (non-empty), /api/v1/* requires Bearer or x-klarbog-api-token.
# Unset = DEV (no bearer). Never commit a real value.
# KLARBOG_API_TOKEN=

# --- Optional session cookie (ADR-017) --------------------------------------
# Requires KLARBOG_API_TOKEN as well. HMAC key for klarbog_session cookie.
# Unset = no /api/v1/auth/login|logout (Bearer-only). Never commit a real value.
# KLARBOG_SESSION_SECRET=
# Force Secure on the cookie (also implied by non-loopback bind + allow flag):
# KLARBOG_SESSION_COOKIE_SECURE=0
# KLARBOG_SESSION_COOKIE_SECURE=1

# --- HTTP client helpers (CLI / agents) --------------------------------------
# KLARBOG_API_BASE=http://127.0.0.1:3195
# KLARBOG_COMPANY=/path/to/klarbog-data/companies/min-aps

# --- Local web UI (DEV; klarbog-api serves /ui/) ------------------------------
# Optional override for static assets (default: repo ui/ next to the workspace).
# KLARBOG_UI_DIR=/path/to/klarbog/ui

# --- Revolut Business API / OAuth (optional; dormant without Business acct) --
# Live E2E skips Revolut import preview until a token is set.
# KLARBOG_REVOLUT_API_TOKEN=
# KLARBOG_REVOLUT_API_BASE=
# KLARBOG_REVOLUT_CLIENT_ID=
# KLARBOG_REVOLUT_CLIENT_SECRET=
# KLARBOG_REVOLUT_REDIRECT_URI=

# --- Stripe API / webhooks (optional) ----------------------------------------
# KLARBOG_STRIPE_SECRET_KEY=
# KLARBOG_STRIPE_API_BASE=https://api.stripe.com
# KLARBOG_STRIPE_WEBHOOK_SECRET=

# --- Object storage (default: local disk under each company) -----------------
# KLARBOG_STORAGE=local
# KLARBOG_STORAGE=r2
# KLARBOG_R2_ACCOUNT_ID=
# KLARBOG_R2_ACCESS_KEY_ID=
# KLARBOG_R2_SECRET_ACCESS_KEY=
# KLARBOG_R2_BUCKET=
# KLARBOG_R2_JURISDICTION=
# KLARBOG_R2_ALLOW_NON_EU=0

# --- DEV packaging -----------------------------------------------------------
# PACKAGE_DEV_NO_SHA256=1   # skip sha256 digests from ./scripts/package-dev.sh

# --- Optional live E2E (./scripts/live-e2e.sh) --------------------------------
# Requires Stripe + R2 above; Revolut token optional (dormant SKIP without it).
# Without Stripe/R2 the script prints SKIP and exits 0.
# With Stripe+R2 set, smokes loopback /health, /api/v1/status, Stripe import preview.
# Never commit filled values. See docs/skills/live-e2e.md
