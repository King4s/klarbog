# Klarbog — example environment (DEV)
# Copy to `.env` (gitignored) or export in the shell that starts klarbog-api / klarbog-mcp.
# All variables are optional for offline CSV/local-disk workflows. Never commit secrets.

# --- Data isolation ----------------------------------------------------------
# Company dirs must live under this root (API/MCP AuthZ allowlist).
# KLARBOG_ALLOWLIST_ROOT=/path/to/klarbog-data
# ALLOWLIST_ROOT=                     # alias used by ./scripts/verify.sh

# --- HTTP client helpers (CLI / agents) --------------------------------------
# KLARBOG_API_BASE=http://127.0.0.1:3195
# KLARBOG_COMPANY=/path/to/klarbog-data/companies/min-aps

# --- Local web UI (DEV; klarbog-api serves /ui/) ------------------------------
# Optional override for static assets (default: repo ui/ next to the workspace).
# KLARBOG_UI_DIR=/path/to/klarbog/ui

# --- Revolut Business API / OAuth (optional) ---------------------------------
# KLARBOG_REVOLUT_API_TOKEN=
# KLARBOG_REVOLUT_API_BASE=
# KLARBOG_REVOLUT_CLIENT_ID=
# KLARBOG_REVOLUT_CLIENT_SECRET=
# KLARBOG_REVOLUT_REDIRECT_URI=

# --- Stripe API / webhooks (optional) ----------------------------------------
# KLARBOG_STRIPE_SECRET_KEY=
# KLARBOG_STRIPE_API_BASE=https://api.stripe.com
# KLARBOG_STRIPE_WEBHOOK_SECRET=

# --- Object storage (default: local disk under each company) -----------------
# KLARBOG_STORAGE=local
# KLARBOG_STORAGE=r2
# KLARBOG_R2_ACCOUNT_ID=
# KLARBOG_R2_ACCESS_KEY_ID=
# KLARBOG_R2_SECRET_ACCESS_KEY=
# KLARBOG_R2_BUCKET=
# KLARBOG_R2_JURISDICTION=
# KLARBOG_R2_ALLOW_NON_EU=0

# --- DEV packaging -----------------------------------------------------------
# PACKAGE_DEV_NO_SHA256=1   # skip sha256 digests from ./scripts/package-dev.sh

# --- Optional live E2E (./scripts/live-e2e.sh) --------------------------------
# Without Revolut + Stripe + R2 secrets above, the script prints SKIP and exits 0.
# With secrets set, it smokes loopback /health, /api/v1/status, import preview API.
# Never commit filled values. See docs/skills/live-e2e.md
